{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/refs/heads/master/schema/tauri.conf.schema.json",
  "productName": "PassGene",
  "version": "2.0.1",
  "identifier": "com.passgene.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PassGene",
        "width": 520,
        "height": 680,
        "resizable": true,
        "minWidth": 420,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Muhammad Bakhit",
    "copyright": "Copyright 2025 Muhammad Bakhit",
    "shortDescription": "A modern password & passphrase generator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
